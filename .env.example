# 百度 OCR 配置
# 本地开发：复制本文件为 .env.local 并填写（.env.local 已被 .gitignore 忽略）。
# GitHub Pages 构建：在仓库 Settings → Secrets and variables → Actions 中配置
# VITE_OCR_ACCESS_TOKEN 和 VITE_OCR_TOKEN_EXPIRES，构建时由 deploy.yml 注入。

# access_token 有效期 30 天，过期后重新获取：
# curl 'https://aip.baidubce.com/oauth/2.0/token?grant_type=client_credentials&client_id=YOUR_CLIENT_ID&client_secret=YOUR_CLIENT_SECRET'
VITE_OCR_ACCESS_TOKEN=

# Token 到期时间（ISO 8601，可选）。留空时会尝试从 access_token 自带的时间戳解析。
VITE_OCR_TOKEN_EXPIRES=
